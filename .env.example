# 環境変数の雛形。実際の値は git 管理外の .env にのみ置く（このファイルには秘密の値を書かないこと）。
#
# 値は手で埋めず、Vercel から取得する：
#   pnpm dlx vercel link            # 初回のみ：ローカルを Vercel プロジェクトに紐付け
#   pnpm dlx vercel env pull .env   # Vercel の Development スコープを .env へ書き出す
#
# 書き出し先に .env を必ず指定する（省くと .env.localに環境変数が入ってしまう）。
# .env.local が残っていたら削除する。

# --- DB ---
#
# 環境ごとに別の DB を見る（→ docs/adr.md ADR-0021）：
#   ローカル … 手元の開発用 DB（compose.yaml）
#   Preview  … Neon の preview ブランチ
#   本番     … Neon の本番ブランチ
#   テスト   … テスト用 DB（compose.test.yaml。接続先は vitest.config.ts が決め、.env の値は使わない）

# アプリの通常クエリ用（Neon では pooled）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mycellar_dev

# マイグレーション用（Neon では direct）
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/mycellar_dev

# --- 認証（Better Auth + Google OAuth）---

# Google OAuth（Google Cloud Console で発行）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth のセッション署名・暗号化キー（`openssl rand -base64 32` で生成・32文字以上）
BETTER_AUTH_SECRET=

# アプリ自身の URL。ローカルは http://localhost:3000。
# Vercel 上では読まれない（リクエストのホストから導出する → src/lib/auth.ts）。
BETTER_AUTH_URL=http://localhost:3000

# preview のログインを本番が中継するときの暗号化キー。Vercel 上だけで読む（手元では要らない）。
# 本番と preview に同じ値を入れる（`openssl rand -base64 32` で生成）。
# OAUTH_PROXY_SECRET=

# --- 見本のデータ（pnpm db:seed）---

# 見本を持たせる利用者のメールアドレス。手元で Google ログインした自分のアカウントを書く。
# この利用者の製品は、seed を流すたびに消えて見本に置き換わる。
SEED_USER_EMAIL=
